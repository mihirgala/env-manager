{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "P0: core + folder picker + sidecar .env/fs access under $HOME",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/**" }]
    }
  ]
}
